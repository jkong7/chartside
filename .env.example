# Optional. Without a key, Chartside runs its on-device clinical engine.
ANTHROPIC_API_KEY=
# Model used for note drafting, translation, and the assistant (default: claude-opus-5).
CHARTSIDE_MODEL=claude-opus-5
# Force the on-device engine even when a key is present: local | auto
CHARTSIDE_ENGINE=auto
# SQLite file location (default: data/chartside.db)
CHARTSIDE_DB=data/chartside.db
# Optional. Enables Deepgram Nova-3 live diarized captions and post-visit re-transcription.
DEEPGRAM_API_KEY=
